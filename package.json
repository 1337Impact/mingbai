{
  "name": "hanzi-lens",
  "description": "Select Chinese text to read it with pinyin, per-word meanings and an English translation.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "wxt build && node tests/e2e.mjs",
    "build:hsk": "node scripts/build-hsk.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "openai": "^7.27.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
